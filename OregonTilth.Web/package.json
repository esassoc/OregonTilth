{
  "name": "oregontilth-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "@powershell nvm install $(Get-Content .nvmrc) && @powershell nvm use $(Get-Content .nvmrc)",
    "start": "ng serve --host 0.0.0.0 --disable-host-check true --port 8887",
    "start-ssl": "ng serve --host 0.0.0.0 --disable-host-check true --port 8886 --ssl --ssl-cert dev_cert.pfx --ssl-key password#1",
    "build": "ng build",
    "build-dev": "ng build",
    "build-qa": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=qa --configuration production",
    "build-prod": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --configuration=production --configuration production",
    "test": "ng test",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/localize": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "@tinymce/tinymce-angular": "^6.0.0",
    "ag-grid-angular": "^28.0.1",
    "ag-grid-community": "^28.0.1",
    "angular-oauth2-oidc": "^19.0.0",
    "angular-oauth2-oidc-jwks": "^17.0.2",
    "bootstrap": "^5.3.2",
    "chart.js": "^4.3.0",
    "color-scheme": "^1.0.1",
    "core-js": "^3.6.5",
    "font-awesome": "^4.7.0",
    "google-palette": "^1.1.0",
    "iso8601-js-period": "^0.2.1",
    "jquery": "^3.4.1",
    "ng-click-outside2": "^17.0.0",
    "ng-multiselect-dropdown": "^1.0.0",
    "ng2-charts": "^8.0.0",
    "ngprogress": "^1.1.3",
    "ngx-cookie-service": "^19.1.2",
    "rxjs": "^7.8.2",
    "style-loader": "^1.2.1",
    "tinymce": "^6.4.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@angular/language-service": "^19.2.25",
    "@fortawesome/fontawesome-free": "^5.11.2",
    "@types/jasmine": "~5.1.0",
    "@types/jasminewd2": "^2.0.8",
    "@types/node": "^22.10.2",
    "jasmine-core": "~5.2.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "^2.1.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-node": "~8.9.1",
    "typescript": "5.8.3"
  }
}
