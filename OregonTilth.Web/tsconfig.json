{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "downlevelIteration": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    // Angular 21 ships its typings under types/ subdirectories exposed through package
    // "exports" subpath maps. The legacy "node" resolver ignores "exports", so imports
    // like @angular/common/http fail to resolve. "bundler" is what the Angular CLI
    // scaffolds and is required from v21 on.
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "types": [
      "node",
      "jasmine"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "useDefineForClassFields": false
  }
}
